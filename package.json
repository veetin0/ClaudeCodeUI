{
  "name": "harness",
  "productName": "Harness",
  "version": "0.1.0",
  "description": "A Mac app to run Claude Code and watch it work in real time",
  "main": "./out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "install-electron && node scripts/fix-node-pty.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && node scripts/build-crew.mjs && vitest run -c vitest.e2e.config.ts",
    "hackforge:sync": "node scripts/sync-hackforge.mjs",
    "design:sync": "node scripts/sync-design-skills.mjs",
    "crew:build": "node scripts/build-crew.mjs",
    "crew:publish": "node scripts/build-crew.mjs && cd crew && npm publish",
    "build:mac": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "release:mac": "electron-vite build && electron-builder --mac",
    "build:win": "electron-vite build && electron-builder --win",
    "build:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "@cloudinary/asset-management-mcp": "0.11.3",
    "@playwright/mcp": "0.0.83",
    "diff": "^9.0.0",
    "hostinger-api-mcp": "3.1.0",
    "node-pty": "^1.1.0",
    "qrcode-generator": "2.0.4",
    "three": "^0.182.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "cmdk": "^1.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "0.25.12",
    "immer": "^11.1.21",
    "lucide-react": "^1.52.0",
    "monaco-editor": "^0.57.0",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "zustand": "^5.0.15"
  },
  "author": {
    "name": "Harness"
  }
}
